<Project>
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Deterministic>true</Deterministic>
    <Version>0.5.1</Version>
    <DefaultItemExcludes>$(DefaultItemExcludes);**/obj/**;**/bin/**</DefaultItemExcludes>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RequireHardware)' == 'true'">
    <DefineConstants>$(DefineConstants);HARDWARE_RELEASE</DefineConstants>
    <BuildFlavor>Hardware</BuildFlavor>
  </PropertyGroup>
  <PropertyGroup Condition="'$(BuildFlavor)' == 'Hardware'">
    <BaseOutputPath>bin\Hardware\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\Hardware\</BaseIntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
