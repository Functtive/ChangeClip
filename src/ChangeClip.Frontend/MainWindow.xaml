<Window x:Class="ChangeClip.Frontend.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ChangeClip" Width="760" Height="720" MinWidth="620" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="{StaticResource AppBackground}"
        FontFamily="Segoe UI" Loaded="Window_Loaded" Closing="Window_Closing" Closed="Window_Closed">
    <Border Background="{StaticResource AppBackground}" Padding="28">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="2,0,2,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="CHANGECLIP" FontSize="13" FontWeight="Bold"
                           Foreground="{StaticResource Muted}" />
                <TextBlock Text="Razmjena novca" FontSize="29" FontWeight="Bold" Margin="0,3,0,0" />
                <TextBlock Text="Prihvataju se samo novčanice od 10 ili 20 KM."
                           FontSize="13" Foreground="{StaticResource Muted}" Margin="0,3,0,0" />
            </StackPanel>
            <Border Grid.Column="1" Visibility="{Binding SimulatorVisibility}"
                    Background="#292044" BorderBrush="#6246A8" BorderThickness="1"
                    CornerRadius="12" Padding="12,7" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Fill="#B69CFF" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="SIMULATOR" FontSize="11" FontWeight="Bold"
                               Foreground="#D9CCFF" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource CardBackground}" CornerRadius="20"
                Padding="20" BorderBrush="#273250" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="PRIMLJENO" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource Muted}" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,2,0,0">
                        <TextBlock Text="{Binding ReceivedAmount}" FontSize="50" FontWeight="Bold"
                                   Foreground="{StaticResource Ink}" />
                    </StackPanel>
                </StackPanel>

                <Border x:Name="StatusPanel" Grid.Row="1" Background="#151D35" CornerRadius="14" Padding="18,10"
                        VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="{Binding Status}" FontSize="19" FontWeight="SemiBold"
                                   Foreground="{StaticResource Ink}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SimulatorHint}" FontSize="13" Foreground="{StaticResource Muted}"
                                   TextWrapping="Wrap" Margin="0,7,0,0" Visibility="{Binding SimulatorHintVisibility}" />
                        <TextBlock Text="{Binding Error}" FontSize="14" Foreground="#FF9B9B"
                                   TextWrapping="Wrap" Margin="0,7,0,0" Visibility="{Binding ErrorVisibility}" />
                    </StackPanel>
                </Border>

                <Grid Grid.Row="2" Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="#232D49" CornerRadius="12" Padding="14,12" Margin="0,0,7,0">
                        <StackPanel>
                            <TextBlock Text="POTVRĐENO ISPLAĆENO" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource Muted}" />
                            <TextBlock Text="{Binding PaidAmount}" FontSize="21" FontWeight="SemiBold" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="#232D49" CornerRadius="12" Padding="14,12" Margin="7,0,0,0">
                        <StackPanel>
                            <TextBlock Text="PREOSTALO" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource Muted}" />
                            <TextBlock Text="{Binding OwedAmount}" FontSize="21" FontWeight="SemiBold" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Button Content="Razmijeni" IsEnabled="{Binding CanExchange}"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    Click="Exchange_Click" />
        </Grid>

        <Expander Grid.Row="3" Header="Simulator — bez stvarnog novca" IsExpanded="False"
                  Visibility="{Binding SimulatorVisibility}" Margin="0,16,0,0"
                  Foreground="{StaticResource Muted}" FontSize="13">
            <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource Outline}"
                    BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock Text="Razvojni simulator; ne koristi fizičke uređaje niti novac."
                               Foreground="{StaticResource Muted}" Margin="0,0,0,10" />
                    <WrapPanel>
                        <Button Content="Ubaci 10 KM" Style="{StaticResource SimulatorButton}"
                                Margin="0,0,8,8" IsEnabled="{Binding CanInsertSimulatorBanknote}"
                                Click="Insert10_Click" />
                        <Button Content="Ubaci 20 KM" Style="{StaticResource SimulatorButton}"
                                Margin="0,0,8,8" IsEnabled="{Binding CanInsertSimulatorBanknote}"
                                Click="Insert20_Click" />
                    </WrapPanel>
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="Zaliha kovanica" VerticalAlignment="Center"
                                   Foreground="{StaticResource Muted}" Margin="0,0,9,0" />
                        <TextBox x:Name="CoinStockBox" Width="80" Padding="8,6"
                                 Background="#10162B" Foreground="{StaticResource Ink}"
                                 BorderBrush="{StaticResource Outline}" VerticalContentAlignment="Center"
                                 IsEnabled="{Binding CanAdjustSimulatorStock}" />
                        <Button Content="Primijeni" Style="{StaticResource SimulatorButton}"
                                Padding="12,6" MinHeight="36" Margin="9,0,0,0"
                                IsEnabled="{Binding CanAdjustSimulatorStock}" Click="ApplyCoins_Click" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </Expander>
    </Grid>
    </Border>
</Window>
